generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

// --- Enums ---
enum UserRole {
  ADMIN
  AREA_MANAGER
  DIAGNOSTIC
  DOCTOR
  PATIENT
  STAFF
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StaffType {
  RECEPTIONIST
  COORDINATOR
}

enum PatientType {
  NORMAL
  EMERGENCY
}

enum RelationType {
  SELF
  MOTHER
  FAThER
  BROTHER
  UNCLE
}

enum AppointmentSource {
  PLATFORM
  STAFF
  MANAGER
  DIAGNOSTIC
  ADMIN
}

enum EmergencyType {
  COORDINATOR
  PLATFORM
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum EmergencyStatus {
  PENDING
  ACCEPT
  REJECTED
}

enum DoctorSessionStatus {
  ABSENT
  ACTIVE
  PAUSED
  ENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// --- Location Models (Admin Controlled) ---

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  areas     Area[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  managers    Manager[]
  diagnostics Diagnostic[]
  doctors     DoctorArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, districtId])
  @@index([districtId])
}

// --- Core User Model ---

model User {
  id          String  @id @default(cuid())
  name        String
  phoneNumber String  @unique
  password    String
  image       String?

  role UserRole @default(PATIENT)

  isPhoneVerified Boolean @default(false)
  deactivate      Boolean @default(false)

  refreshToken      String?
  isDefaultPassword Boolean @default(false)

  doctor     Doctor?
  diagnostic Diagnostic?
  manager    Manager?
  staff      Staff?

  patient Patient?

  // 🔥 Who created appointments
  createdAppointments Appointment[] @relation("AppointmentCreator")

  emergencyRequests EmergencyRequest[]

  deviceTokens DeviceToken[]

  doctorReviewsWritten DoctorReview[]      @relation("UserDoctorReviews")
  doctorReviewReplies  DoctorReviewReply[] @relation("UserDoctorReviewReplies")

  diagnosticReviewsWritten DiagnosticReview[]      @relation("UserDiagnosticReviews")
  diagnosticReviewReplies  DiagnosticReviewReply[] @relation("UserDiagnosticReviewReplies")

  feedbacks Feedback[]

  createdMemberships Membership[] @relation("MembershipCreator")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  doctorReviews DoctorReview[]
}

model Otp {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  otp         String
  otpExpires  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([otp, phoneNumber])
}

model Manager {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
}

model Department {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  image   String?
  doctors Doctor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Doctor {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String         @unique
  appointments   Appointment[]
  specialization String
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id])
  website        String?
  position       String?
  education      Json?
  hospital       String?        @db.Text
  gender         Gender?        @default(MALE)
  experience     Int            @default(0)
  isEmergency    Boolean        @default(false)
  areas          DoctorArea[]
  memberships    Membership[]
  reviews        DoctorReview[]
  averageRating  Float          @default(0.0)
  reviewsCount   Int            @default(0)
  staffs         Staff[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([slug])
  @@index([departmentId])
}

model DoctorArea {
  id       String @id @default(cuid())
  doctorId String
  areaId   String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  area     Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([doctorId, areaId])
}

model Diagnostic {
  id            String             @id @default(cuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String             @unique
  reviews       DiagnosticReview[]
  averageRating Float              @default(0.0)
  reviewsCount  Int                @default(0)
  address       String
  areaId        String
  area          Area               @relation(fields: [areaId], references: [id])
  website       String?
  appointments  Appointment[]
  memberships   Membership[]
  staffs        Staff[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([areaId])
}

model Staff {
  id               String     @id @default(cuid())
  userId           String     @unique
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagId           String
  diagnostic       Diagnostic @relation(fields: [diagId], references: [id], onDelete: Cascade)
  assignedDoctorId String?
  assignedDoctor   Doctor?    @relation(fields: [assignedDoctorId], references: [id])
  staffType        StaffType  @default(RECEPTIONIST)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([diagId])
  @@index([assignedDoctorId])
}

model DoctorSession {
  id String @id @default(cuid())

  doctorId      String
  diagId        String
  runningSerial Int                 @default(0)
  status        DoctorSessionStatus @default(ABSENT)

  startedAt DateTime?
  pausedAt  DateTime?
  endedAt   DateTime?

  updatedAt DateTime @updatedAt

  @@index([doctorId, diagId])
}

// --- Appointments & Schedules ---

model Membership {
  id           String        @id @default(cuid())
  doctorId     String
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  diagId       String
  diagnostic   Diagnostic    @relation(fields: [diagId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User          @relation("MembershipCreator", fields: [createdById], references: [id])
  fee          Int           @default(0)
  discount     Int           @default(0)
  active       Boolean       @default(true)
  schedules    Schedule[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@unique([doctorId, diagId])
}

model Schedule {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  time         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model AppointmentCounter {
  id         String   @id @default(cuid())
  doctorId   String
  diagId     String
  date       DateTime
  lastSerial Int

  @@unique([doctorId, diagId, date])
}

model Appointment {
  id              String            @id @default(cuid())
  patientName     String
  age             Int
  appointmentDate DateTime
  contactNumber   String
  serialNumber    Int
  source          AppointmentSource @default(PLATFORM)
  status          AppointmentStatus @default(SCHEDULED)
  address         String?
  paymentMethod   String?
  consultationFee Int?
  transactionId   String?
  paymentStatus   PaymentStatus     @default(PENDING)
  // =================================================
  // DOCTOR
  // =================================================
  isEmergency     Boolean           @default(false)
  doctorId        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  // =================================================
  // DIAGNOSTIC
  // =================================================

  diagId     String?
  diagnostic Diagnostic? @relation(fields: [diagId], references: [id], onDelete: Cascade)

  // =================================================
  // WHO CREATED THIS APPOINTMENT
  // =================================================

  createdById String
  createdBy   User   @relation("AppointmentCreator", fields: [createdById], references: [id])

  // =================================================
  // OPTIONAL EMERGENCY
  // =================================================

  emergency EmergencyRequest?

  medicalRecords MedicalRecord[]

  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, appointmentDate])
  @@index([createdById])
}

model EmergencyRequest {
  id String @id @default(cuid())

  appointmentId String          @unique
  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          EmergencyType   @default(PLATFORM)
  status        EmergencyStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User?           @relation(fields: [userId], references: [id])
  userId        String?
}

model Patient {
  id        String   @id @default(cuid())
  age       Int      @default(0)
  gender    Gender   @default(MALE)
  address   String?
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, age])
}

// ==================== ১. ডক্টর রিভিউ ও রিপ্লাই ====================
model DoctorReview {
  id      String  @id @default(cuid())
  rating  Int     @default(1) @db.SmallInt
  comment String? @db.Text

  reviewerId String
  reviewer   User   @relation("UserDoctorReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  status ReviewStatus       @default(PENDING)
  reply  DoctorReviewReply?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@unique([reviewerId, doctorId])
}

model DoctorReviewReply {
  id      String @id @default(cuid())
  content String @db.Text

  reviewId String       @unique
  review   DoctorReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  repliedById String
  repliedBy   User   @relation("UserDoctorReviewReplies", fields: [repliedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== ২. ক্লিনিক রিভিউ ও রিপ্লাই ====================
model DiagnosticReview {
  id      String  @id @default(cuid())
  rating  Int     @default(1) @db.SmallInt
  comment String? @db.Text

  reviewerId String
  reviewer   User   @relation("UserDiagnosticReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  diagId     String
  diagnostic Diagnostic @relation(fields: [diagId], references: [id], onDelete: Cascade)

  status ReviewStatus           @default(PENDING)
  reply  DiagnosticReviewReply?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reviewerId, diagId])
}

model DiagnosticReviewReply {
  id      String @id @default(cuid())
  content String @db.Text

  diagReviewId     String           @unique
  diagnosticReview DiagnosticReview @relation(fields: [diagReviewId], references: [id], onDelete: Cascade)
  repliedById      String
  repliedBy        User             @relation("UserDiagnosticReviewReplies", fields: [repliedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// platform review
model Feedback {
  id        String       @id @default(cuid())
  rating    Int          @default(1)
  comment   String?      @db.Text
  patientId String
  patient   User         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([patientId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String? // e.g., "android", "ios", "web"
  createdAt DateTime @default(now())

  @@index([userId])
}

model MedicalRecord {
  id            String      @id @default(cuid())
  name          String
  description   String?     @db.Text
  date          DateTime    @default(now())
  document      String?
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appointmentId])
}
