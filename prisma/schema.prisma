generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

// --- Enums ---
enum UserRole {
  ADMIN
  AREA_MANAGER
  DIAGNOSTIC_MANAGER
  DOCTOR
  PATIENT
  STAFF
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StaffType {
  RECEPTIONIST
  COORDINATOR
}

enum PatientType {
  NORMAL
  EMERGENCY
}

enum AppointmentSource {
  PLATFORM
  STAFF
  MANAGER
  CLINIC
  ADMIN
}

enum EmergencyType {
  COORDINATOR
  PLATFORM
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// --- Location Models (Admin Controlled) ---

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  areas     Area[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  managers Manager[]
  clinics  Clinic[]
  doctors  DoctorArea[]
  patient  Patient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, districtId])
  @@index([districtId])
}

// --- Core User Model ---

model User {
  id                String   @id @default(cuid())
  name              String
  phoneNumber       String   @unique
  password          String
  image             String?
  role              UserRole @default(PATIENT)
  isPhoneVerified   Boolean  @default(false)
  deactivate        Boolean  @default(false)
  refreshToken      String?
  isDefaultPassword Boolean  @default(false)

  // প্রোফাইল লিঙ্ক
  doctor  Doctor?
  patient Patient?
  clinic  Clinic?
  manager Manager?
  // createdMemberships Membership[] @relation("MembershipCreator")

  deviceTokens DeviceToken[]

  staff Staff?

  createdMemberships  Membership[]  @relation("MembershipCreator")
  createdAppointments Appointment[] @relation("AppointmentCreator")
  reviewsWritten      Review[]      @relation("UserReviews")

  reviewReplies     ReviewReply[]
  feedbacks         Feedback[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  emergencyRequests EmergencyRequest[]
}

model Otp {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  otp         String
  otpExpires  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([otp, phoneNumber])
}

model Manager {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
}

model Department {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  image   String?
  doctors Doctor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Doctor {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String        @unique
  appointments   Appointment[]
  specialization String
  departmentId   String
  department     Department    @relation(fields: [departmentId], references: [id])
  website        String?
  position       String?
  education      Json?
  hospital       String?       @db.Text
  gender         Gender?       @default(MALE)
  experience     Int           @default(0)
  areas          DoctorArea[]
  memberships    Membership[]
  reviews        Review[]
  averageRating  Float         @default(0.0)
  reviewsCount   Int           @default(0)
  staffs         Staff[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([slug])
  @@index([departmentId])
}

model DoctorArea {
  id       String @id @default(cuid())
  doctorId String
  areaId   String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  area     Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([doctorId, areaId])
}

model Clinic {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String        @unique
  address      String
  areaId       String
  area         Area          @relation(fields: [areaId], references: [id])
  website      String?
  appointments Appointment[]
  memberships  Membership[]
  staffs       Staff[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([areaId])
}

model Staff {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId         String
  clinic           Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  assignedDoctorId String?
  assignedDoctor   Doctor?   @relation(fields: [assignedDoctorId], references: [id])
  staffType        StaffType @default(RECEPTIONIST)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([clinicId])
  @@index([assignedDoctorId])
}

// --- Appointments & Schedules ---

model Membership {
  id           String        @id @default(cuid())
  doctorId     String
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User          @relation("MembershipCreator", fields: [createdById], references: [id])
  fee          Int           @default(0)
  discount     Int           @default(0)
  active       Boolean       @default(true)
  schedules    Schedule[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@unique([doctorId, clinicId])
}

model Schedule {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  time         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model AppointmentCounter {
  id         String   @id @default(cuid())
  doctorId   String
  clinicId   String
  date       DateTime
  lastSerial Int

  @@unique([doctorId, clinicId, date])
}

model Appointment {
  id              String            @id @default(cuid())
  patientName     String
  ptAge           String
  type            PatientType       @default(NORMAL)
  phoneNumber     String
  address         String?
  note            String?
  appointmentDate DateTime
  createdById     String?
  createdBy       User?             @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  source          AppointmentSource @default(PLATFORM)
  serialNumber    Int
  status          AppointmentStatus @default(SCHEDULED)
  doctorId        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId        String
  clinic          Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  medicalRecords   MedicalRecord[]
  emergency        EmergencyRequest?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  membership       Membership?       @relation(fields: [membershipId], references: [id])
  membershipId     String?
  emergencyRequest EmergencyRequest?

  @@unique([doctorId, appointmentDate, serialNumber])
  @@index([doctorId, appointmentDate])
  @@index([patientId, appointmentDate])
}

model EmergencyRequest {
  id String @id @default(cuid())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  type EmergencyType

  transactionId String?
  paymentStatus PaymentStatus @default(PENDING)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Feedback System ---

model Review {
  id         String       @id @default(cuid())
  rating     Int          @default(1) @db.SmallInt
  comment    String?      @db.Text
  reviewerId String
  reviewer   User         @relation("UserReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  doctorId   String
  doctor     Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  status     ReviewStatus @default(PENDING)
  reply      ReviewReply?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([reviewerId, doctorId])
}

model Feedback {
  id        String       @id @default(cuid())
  rating    Int          @default(1)
  comment   String?      @db.Text
  patientId String
  patient   User         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([patientId])
}

model ReviewReply {
  id       String @id @default(cuid())
  content  String @db.Text
  reviewId String @unique
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  repliedById String
  repliedBy   User     @relation(fields: [repliedById], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Patient {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  age          Int?
  gender       Gender?       @default(MALE)
  address      String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  area         Area?         @relation(fields: [areaId], references: [id])
  areaId       String?
}

model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String? // e.g., "android", "ios", "web"
  createdAt DateTime @default(now())

  @@index([userId])
}

model MedicalRecord {
  id            String      @id @default(cuid())
  name          String
  description   String?     @db.Text
  date          DateTime    @default(now())
  document      String?
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appointmentId])
}
