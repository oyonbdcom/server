generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

// --- Enums ---
enum UserRole {
  ADMIN
  MANAGER
  CLINIC
  DOCTOR
  PATIENT
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// --- Location Models (Admin Controlled) ---

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  areas     Area[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  managers Manager[]
  clinics  Clinic[]
  doctors  DoctorArea[]
  patient  Patient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, districtId])
  @@index([districtId])
}

// --- Core User Model ---

model User {
  id                String   @id @default(cuid())
  name              String
  phoneNumber       String   @unique
  password          String
  image             String?
  role              UserRole @default(PATIENT)
  isPhoneVerified   Boolean  @default(false)
  deactivate        Boolean  @default(false)
  refreshToken      String?
  isDefaultPassword Boolean  @default(false)

  // প্রোফাইল লিঙ্ক
  doctor                Doctor?
  patient               Patient?
  clinic                Clinic?
  manager               Manager?
  createdMemberships    Membership[]  @relation("MembershipCreator")
  // অ্যাপয়েন্টমেন্ট রিলেশনস
  appointmentsAsDoctor  Appointment[] @relation("DoctorAppointments")
  appointmentsAsPatient Appointment[] @relation("PatientAppointments")
  appointmentsAsClinic  Appointment[] @relation("ClinicAppointments")
  deviceTokens          DeviceToken[]
  // রিভিউ রিলেশনস
  reviewsWritten        Review[]      @relation("UserReviews")
  reviewReplies         ReviewReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
}

model Otp {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  otp         String
  otpExpires  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([otp, phoneNumber])
}

// --- Role Specific Profiles ---

model Manager {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
}

// --- নতুন ডিপার্টমেন্ট মডেল ---
model Department {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  image   String?
  doctors Doctor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- আপডেট করা ডক্টর মডেল ---
model Doctor {
  id             String @id @default(cuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String @unique
  specialization String

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  website       String?
  position      String?
  education     Json?
  hospital      String?      @db.Text
  gender        Gender?      @default(MALE)
  experience    Int          @default(0)
  // রিলেশনশিপ
  areas         DoctorArea[]
  memberships   Membership[]
  reviews       Review[]
  averageRating Float        @default(0.0)
  reviewsCount  Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([departmentId])
}

model DoctorArea {
  id       String @id @default(cuid())
  doctorId String
  areaId   String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  area     Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([doctorId, areaId])
}

model Clinic {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  slug    String @unique
  address String

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
}

// --- Appointments & Schedules ---

model Membership {
  id           String        @id @default(cuid())
  doctorId     String
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User          @relation("MembershipCreator", fields: [createdById], references: [id])
  fee          Int           @default(0)
  discount     Int           @default(0)
  active       Boolean       @default(true)
  schedules    Schedule[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, clinicId])
}

model Schedule {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  time         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id              String            @id @default(cuid())
  patientName     String
  ptAge           String
  phoneNumber     String
  address         String?
  note            String?
  appointmentDate DateTime
  times           String?
  discount        Int?
  refby           String?
  serialNumber    Int?
  code            String?
  status          AppointmentStatus @default(SCHEDULED)
  doctorId        String
  doctor          User              @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  patientId       String
  patient         User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  clinicId        String
  clinic          User              @relation("ClinicAppointments", fields: [clinicId], references: [id], onDelete: Cascade)
  medicalRecords  MedicalRecord[]
  membershipId    String
  membership      Membership?       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([doctorId, appointmentDate])
  @@index([patientId, appointmentDate])
}

// --- Feedback System ---

model Review {
  id      String  @id @default(cuid())
  rating  Int     @default(1)
  comment String? @db.Text

  // কে রিভিউ দিচ্ছে
  reviewerId String
  reviewer   User   @relation("UserReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  // ডাক্তারকে রিভিউ দিলে doctorId থাকবে
  doctorId String?
  doctor   Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  status ReviewStatus @default(PENDING)
  reply  ReviewReply?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reviewerId, doctorId])
}

model ReviewReply {
  id       String @id @default(cuid())
  content  String @db.Text
  reviewId String @unique
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  repliedById String
  repliedBy   User   @relation(fields: [repliedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Patient {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age       Int?
  gender    Gender?  @default(MALE)
  address   String?
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String? // e.g., "android", "ios", "web"
  createdAt DateTime @default(now())

  @@index([userId])
}

model MedicalRecord {
  id            String      @id @default(cuid())
  name          String
  description   String?     @db.Text
  date          DateTime    @default(now())
  document      String?
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appointmentId])
}
